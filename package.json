{
  "name": "hg_textharvest_v2",
  "version": "1.0.0",
  "description": "Text extraction tool by Curlew Geospatial",
  "main": "index.js",
  "bin": {
    "th": "./bin/textharvester"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "coverage": "jest --config jest.config.cjs --coverage",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "local-start": "NODE_ENV=development nodemon server.js --ignore 'data/*' --ignore 'uploads/*'",
    "lint": "eslint .",
    "migrate:remove-confidence-score": "node scripts/remove-confidence-score.js",
    "migrate:add-model-columns": "node scripts/migrate-add-model-columns.js",
    "migrate:add-source-type": "node scripts/migrate-add-source-type.js",
    "init-db": "node scripts/init-db.js",
    "th": "node bin/textharvester",
    "th:ingest": "node bin/textharvester ingest",
    "th:query": "node bin/textharvester query",
    "th:help": "node bin/textharvester --help",
    "verify:migrations": "node scripts/verify-migration-transactions.js",
    "test:audit-e2e": "node scripts/test-audit-logging-e2e.js",
    "test:e2e": "node scripts/e2e-test.js",
    "test:e2e-upload": "node scripts/e2e-test-upload.js"
  },
  "keywords": [
    "ocr",
    "heritage",
    "genealogy",
    "text-extraction",
    "handwriting-recognition",
    "burial-records",
    "memorials",
    "graveyard",
    "archival",
    "cli"
  ],
  "author": "Daniel Tierney",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/donalotiarnaigh/textharvester-web.git"
  },
  "homepage": "https://github.com/donalotiarnaigh/textharvester-web#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^2.2.0",
    "ajv": "^8.17.1",
    "axios": "^1.8.2",
    "chalk": "^6.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "dropzone": "^6.0.0-beta.2",
    "express": "^5.2.1",
    "form-data": "^4.0.2",
    "glob": "^13.0.6",
    "helmet": "^8.3.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "open": "^11.0.4",
    "openai": "^7.17.0",
    "pdf-poppler": "^0.2.1",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "@flydotio/dockerfile": "^0.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "babel-jest": "^30.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "husky": "^9.0.11",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.5.1",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "overrides": {
    "prebuild-install": {
      "tar-fs": "2.1.4"
    }
  }
}
